rules_version = '2';

// REGRAS DE SEGURANÇA DO PIZZACONTROL
//
// usuarios/{uid}       -> cadastro e plano do cliente. Gravado SÓ pelo Make (conexão de
//                         administrador, que não passa por estas regras). O cliente só lê o próprio.
// dadosClientes/{uid}  -> dados da pizzaria (insumos, fichas, custos...), sincronizados entre
//                         os aparelhos do cliente. Cada cliente lê e grava SÓ o próprio documento,
//                         e só enquanto o plano estiver ativo ("basico" ou "pro").
// config/bonusPro      -> link do grupo de pizzaiolos. Só contas com plano "pro" leem.
//                         Gravado só pelo Make (administrador).
// extras/{email}        -> compras extras (ex.: cardapioPronto: true). Gravado só pelo Make.
//                         O cliente lê só o do próprio e-mail.
// config/cardapioPronto -> sabores do Cardápio Pronto. Só quem comprou lê.
// Qualquer outra coleção: bloqueada.
//
// COMO PUBLICAR: copie tudo e cole em Firebase Console > Firestore Database > Regras > Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /dadosClientes/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/usuarios/$(userId)).data.plano in ['basico', 'pro']
        && request.resource.data.keys().hasOnly(['db', 'atualizadoEm', 'dispositivo', 'versaoApp'])
        && request.resource.data.db is string
        && request.resource.data.db.size() < 700000
        && request.resource.data.atualizadoEm is int;

      allow delete: if false;
    }

    match /config/bonusPro {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.plano == 'pro';
      allow write: if false;
    }

    match /extras/{email} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /config/cardapioPronto {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/extras/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/extras/$(request.auth.token.email.lower())).data.cardapioPronto == true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
